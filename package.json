{
  "name": "vz-book-2026",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "typecheck": "astro check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "stylelint": "stylelint \"src/**/*.scss\"",
    "stylelint:fix": "stylelint \"src/**/*.scss\" --fix",
    "pretest": "astro sync",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "pretest:watch": "astro sync",
    "test:watch": "vitest",
    "pretest:coverage": "astro sync",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "sonar:up": "docker compose -f docker-compose.sonar.yml up -d",
    "sonar:down": "docker compose -f docker-compose.sonar.yml down",
    "sonar:scan": "docker run --rm --network=vz-book-sonar_default -v \"$(pwd):/usr/src\" -e SONAR_HOST_URL=http://sonarqube:9000 -e SONAR_TOKEN sonarsource/sonar-scanner-cli",
    "lighthouse": "npm run build && lhci autorun --config=lighthouserc.json",
    "size": "npm run build && size-limit",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,ts,astro}": "eslint --fix",
    "*.{js,ts,astro,scss,json,md}": "prettier --write",
    "*.scss": "stylelint --fix"
  },
  "size-limit": [
    {
      "name": "Client-side JS (per page bundle)",
      "path": "dist/assets/*.js",
      "limit": "20 KB"
    }
  ],
  "overrides": {
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    }
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/sitemap": "^3.7.2",
    "astro": "^7.0.6",
    "mermaid": "^11.16.0",
    "sass": "^1.83.0",
    "svg-pan-zoom": "^3.6.2",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.62.1",
    "@size-limit/file": "^13.0.3",
    "@vitest/coverage-v8": "^4.1.11",
    "astro-eslint-parser": "^3.1.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.1.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "size-limit": "^13.0.3",
    "stylelint": "^17.14.1",
    "stylelint-config-prettier-scss": "^1.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.9"
  }
}
